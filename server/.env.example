# Copy this file to .env for local docker, or paste each key into
# Render → your Web Service → Environment.
# ASP.NET Core maps nested JSON with double underscores (__).

# --- Host ---
ASPNETCORE_ENVIRONMENT=Production
# Render injects PORT automatically. Local docker can omit this.
# PORT=8080

# --- Database (SQL Server / Azure SQL — this API does not use Render Postgres) ---
# Local:
# postgres__connectionString=Server=localhost,1433;Database=SafeZone;User Id=sa;Password=Your_strong_Password123;TrustServerCertificate=True;Encrypt=True;MultipleActiveResultSets=True;
# Azure SQL:
postgres__connectionString=Server=tcp:YOUR_SERVER.database.windows.net,1433;Initial Catalog=SafeZone;User ID=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=False;MultipleActiveResultSets=True;Connection Timeout=30;

# --- JWT (generate a long random key, 32+ chars) ---
auth__jwt__issuer=SafeZone
auth__jwt__audience=SafeZone
auth__jwt__validIssuer=SafeZone
auth__jwt__validAudience=SafeZone
auth__jwt__validateAudience=true
auth__jwt__validateIssuer=true
auth__jwt__validateLifetime=true
auth__jwt__issuerSigningKey=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
auth__jwt__expiry=07.00:00:00

# --- AES encryption (must be exactly 32 characters) ---
security__encryption__enabled=true
security__encryption__key=REPLACE_WITH_EXACTLY_32_CHAR_KEY!

# --- CORS / SignalR (your deployed frontend origin, no trailing slash) ---
cors__allowCredentials=true
cors__allowedOrigins__0=https://YOUR-FRONTEND.vercel.app
cors__allowedOrigins__1=http://localhost:5173
cors__allowedMethods__0=GET
cors__allowedMethods__1=POST
cors__allowedMethods__2=PUT
cors__allowedMethods__3=DELETE
cors__allowedMethods__4=OPTIONS
cors__allowedHeaders__0=Content-Type
cors__allowedHeaders__1=Authorization
cors__exposedHeaders__0=Resource-ID

# --- Email (Gmail SMTP app password) ---
GmailSmtpSettings__Email=you@gmail.com
GmailSmtpSettings__FromName=SafeZone
GmailSmtpSettings__AppPassword=your-16-char-app-password

# --- SendGrid (optional; Gmail SMTP is what the app currently uses) ---
SendGrid__ApiKey=SG.your-sendgrid-api-key
SendGrid__FromEmail=you@gmail.com
SendGrid__FromName=SafeZone Notifications

# --- Paystack ---
paystack__baseUrl=https://api.paystack.co
paystack__secretKey=sk_test_your_paystack_secret_key
paystack__callbackUrl=https://YOUR-FRONTEND.vercel.app/payment/callback

# --- Logging (console only on Render; disk is ephemeral) ---
logger__level=information
logger__console__enabled=true
logger__file__enabled=false
logger__seq__enabled=false
